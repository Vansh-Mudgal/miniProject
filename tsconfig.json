{
    "compilerOptions": {
      "experimentalDecorators": true,
      "allowJs": true,
      "emitDecoratorMetadata": true,
      "target": "es2016",
      "module": "commonjs",  // Keep this for Node.js compatibility
      "rootDir": "./src",
      "moduleResolution": "node",  // Ensure Node module resolution
      "resolveJsonModule": true,
      "esModuleInterop": true,  // This is critical for default imports from CommonJS
      "skipLibCheck": true,  // Optionally skip type checking in .d.ts files for faster compilation
      "forceConsistentCasingInFileNames": true,  // Ensure correct file casing
      "outDir": "./dist",  // Output compiled files to ./dist folder
      "strict": true  // Enforce strict type checking
    },
    "include": ["src/**/*", "/jest.config.js"],
    "exclude": ["node_modules"]
}
  